{
  "input_dir": "dataset/processed/original",
  "preparation_manifest": "dataset/processed/original/reports/run_manifest.json",
  "output_dir": "artifacts/modeling/complete_cases",
  "report_dir": "reports/modeling/complete_cases",
  "seed": 42,
  "folds": 5,
  "threshold": 0.5,
  "bootstrap_repetitions": 1000,
  "models": [
    "logistic_regression",
    "random_forest",
    "xgboost"
  ],
  "parameters": {
    "logistic_regression": {
      "C": 1.0,
      "max_iter": 3000,
      "solver": "lbfgs"
    },
    "random_forest": {
      "n_estimators": 300,
      "max_depth": 5,
      "min_samples_leaf": 5,
      "max_features": "sqrt",
      "n_jobs": 1
    },
    "xgboost": {
      "n_estimators": 200,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_lambda": 1.0,
      "tree_method": "hist",
      "n_jobs": 1
    }
  },
  "explanations": {
    "experiment": "matched_fusion",
    "models": [
      "logistic_regression",
      "xgboost"
    ],
    "background_participants": 30,
    "permutation_cycles": 5,
    "top_features": 5
  }
}
