{
  "baseline_run": "dataset/cohorts/apoe_primary",
  "run_name": "ensembles",
  "experiments": [
    "apoe_clinical",
    "apoe_fusion",
    "apoe_csf_clinical",
    "apoe_csf_clinical_apoe",
    "apoe_csf_clinical_csf",
    "apoe_csf_fusion"
  ],
  "seed": 42,
  "inner_folds": 3,
  "threshold": 0.5,
  "bootstrap_repetitions": 1000,
  "base_models": [
    "logistic_regression",
    "random_forest",
    "xgboost",
    "extra_trees"
  ],
  "extra_trees": {
    "n_estimators": 300,
    "max_depth": 8,
    "min_samples_leaf": 3,
    "max_features": "sqrt",
    "n_jobs": 1
  },
  "voting_weight_step": 0.25,
  "stacking_C": 0.1,
  "input_format": "v2",
  "output_root": "artifactsv2/suite_apoe_primary"
}
